# ==============================================================================
# Optimark Headless CMS - Frontend Environment Configuration (.env.local)
# ==============================================================================
# Copy this file to .env.local for local development, or supply these
# as environment variables / Docker build ARGs for production deployment.
# ==============================================================================

# CMS Backend API URL (NestJS REST API)
# Must point to the public-facing or reverse-proxied CMS backend endpoint.
# Local development default: http://localhost:3001/api
# Production example: https://api-cms.optimark.ai/api
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Landing Page URL
# Used for live previewing published/draft articles on the main website.
# Local development default: http://localhost:3000
# Production example: https://optimark.ai
NEXT_PUBLIC_LANDING_URL="http://localhost:3000"

# Port for local dev or standalone container
PORT=3002
