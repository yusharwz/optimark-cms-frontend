{
  "name": "optimark.cms-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "secrets:pull": "infisical export --env=dev > .env.local",
    "secrets:pull:staging": "infisical export --env=staging > .env.local",
    "secrets:pull:prod": "infisical export --env=prod > .env.local",
    "secrets:push:dev": "infisical secrets set --file=.env.local --env=dev",
    "secrets:push:staging": "infisical secrets set --file=.env.local --env=staging",
    "secrets:push:prod": "infisical secrets set --file=.env.local --env=prod"
  },
  "dependencies": {
    "@types/markdown-it": "^14.2.0",
    "@untitledui/icons": "^0.0.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.56.0",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.31.0"
}
